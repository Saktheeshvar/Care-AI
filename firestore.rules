rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCaregiver() {
      return isAuthenticated() && getUserRole() == 'CAREGIVER';
    }

    function isAssignedCaregiver(elderlyId) {
      return isCaregiver() && 
        get(/databases/$(database)/documents/elderlyUsers/$(elderlyId)).data.caregiverId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Elderly user profiles
    match /elderlyUsers/{elderlyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        resource.data.caregiverId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isCaregiver()
      );
      allow delete: if isCaregiver();
    }

    // Caregivers collection
    match /caregivers/{caregiverId} {
      allow read: if isAuthenticated();
      allow write: if isCaregiver() && resource.data.userId == request.auth.uid;
    }

    // Medicines collection: Caregivers can CRUD; Elderly can ONLY read
    match /medicines/{medicineId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCaregiver();
    }

    // Reminders collection: Elderly can update status only (TAKEN / NOT_CONFIRMED)
    match /reminders/{reminderId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isCaregiver() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow create, delete: if isCaregiver();
    }

    // Reminder history audit collection
    match /reminderHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Caregiver notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.caregiverId == request.auth.uid || isCaregiver());
      allow update: if isAuthenticated() && (resource.data.caregiverId == request.auth.uid || isCaregiver());
      allow create: if isAuthenticated();
      allow delete: if isCaregiver();
    }

    // AI Messages
    match /aiMessages/{messageId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        request.resource.data.userId == request.auth.uid
      );
    }
  }
}
